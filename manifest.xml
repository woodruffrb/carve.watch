<?xml version="1.0"?>
<!--
  carve.watch - wrist telemetry for self-balancing single-wheel boards.
  Copyright (c) Derivative.Engineering LLC. MIT licensed.

  minApiLevel is pinned to 3.1.0: that is the release that introduced
  Toybox.BluetoothLowEnergy, without which none of this works.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="CarveApp"
        id="f59c9f3ceb744e9d8c186dbb300494cf"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.1.0"
        name="@Strings.AppName"
        type="watch-app">

        <!--
          Tier 1: devices confirmed to support both Toybox.BluetoothLowEnergy
          and Toybox.Cryptography, with enough watch-app memory for the BLE
          stack plus a UI. fenix6xpro covers the 6X Pro / 6X Sapphire /
          6X Pro Solar, which is the reference target.

          To widen this list, download the device in the SDK Manager first -
          monkeyc reports an uninstalled device as an invalid id, which reads
          like a typo but is not. Check the Device Reference for
          BluetoothLowEnergy support before adding an id, and add them one at
          a time so a failure points at a known culprit.

          Forerunner 945/955/965 and Venu 2/2S are intended targets that are
          simply not installed in this SDK yet.
        -->
        <iq:products>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix6spro"/>
            <iq:product id="fenix6xpro"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix7spro"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fenix8solar51mm"/>
            <iq:product id="epix2"/>
            <iq:product id="epix2pro42mm"/>
            <iq:product id="epix2pro47mm"/>
            <iq:product id="epix2pro51mm"/>
            <iq:product id="vivoactive4"/>
            <iq:product id="vivoactive4s"/>
            <iq:product id="vivoactive5"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="BluetoothLowEnergy"/>
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="FitContributor"/>
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
